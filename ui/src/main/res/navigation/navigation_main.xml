<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation_main"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.miiiin15.whereru.ui.splash.SplashFragment"
        android:label="splashFragment"
        tools:layout="@layout/fragment_splash">

        <action
            android:id="@+id/action_splash_to_auth"
            app:destination="@id/authFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" >
            <argument
                android:name="fcmToken"
                app:argType="string" />
        </action>

        <action
            android:id="@+id/action_splash_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/authFragment"
        android:name="com.miiiin15.whereru.ui.auth.AuthFragment"
        android:label="authFragment"
        tools:layout="@layout/fragment_auth">
        <argument
            android:name="fcmToken"
            app:argType="string" />

        <action
            android:id="@+id/action_auth_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/authFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.miiiin15.whereru.ui.home.HomeFragment"
        android:label="homeFragment"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_home_to_liveLocation"
            app:destination="@id/LiveLocationFragment"
            app:popUpTo="@id/homeFragment" />

    </fragment>

    <fragment
        android:id="@+id/LiveLocationFragment"
        android:name="com.miiiin15.whereru.ui.location.LiveLocationFragment"
        android:label="liveLocationFragment"
        tools:layout="@layout/fragment_live_location">

    </fragment>


</navigation>