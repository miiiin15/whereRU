<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- 기본 흑백 컬러 설정 -->
        <item name="colorPrimary">@color/black</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/gray2</item>

        <!-- 배경색을 흰색으로 설정 -->
        <item name="android:windowBackground">@color/white</item>

        <!-- 시스템 바 설정 -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/black</item>

        <!-- 텍스트 색상 설정 -->
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">@color/gray1</item>
    </style>

    <!-- 제목 스타일 -->
    <style name="Title">
        <item name="android:textSize">@dimen/text_size_title</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 부제목 스타일 -->
    <style name="Subtitle">
        <item name="android:textSize">@dimen/text_size_subtitle</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- 설명 스타일 -->
    <style name="Description">
        <item name="android:textSize">@dimen/text_size_description</item>
        <item name="android:textColor">@color/gray1</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- 텍스트 스타일 1 (큰 텍스트) -->
    <style name="Large">
        <item name="android:textSize">@dimen/text_size_large</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <!-- 텍스트 스타일 2 (중간 크기) -->
    <style name="Medium">
        <item name="android:textSize">@dimen/text_size_medium</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <!-- 텍스트 스타일 3 (기본 크기) -->
    <style name="Small">
        <item name="android:textSize">@dimen/text_size_small</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <!-- 텍스트 스타일 1 (볼드) -->
    <style name="LargeBold">
        <item name="android:textSize">@dimen/text_size_large</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 텍스트 스타일 2 (중간 크기 볼드) -->
    <style name="MediumBold">
        <item name="android:textSize">@dimen/text_size_medium</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 텍스트 스타일 3 (작은 크기 볼드) -->
    <style name="SmallBold">
        <item name="android:textSize">@dimen/text_size_small</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 버튼 텍스트 스타일 -->
    <style name="Button">
        <item name="android:textSize">@dimen/text_size_button</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- 오류 메시지 스타일 -->
    <style name="Error">
        <item name="android:textSize">@dimen/text_size_small</item>
        <item name="android:textColor">@color/error</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- 비활성화 텍스트 (연한 회색) -->
    <style name="Disabled">
        <item name="android:textSize">@dimen/text_size_small</item>
        <item name="android:textColor">@color/gray1</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- 서브 텍스트 (조금 더 진한 회색) -->
    <style name="SubText">
        <item name="android:textSize">@dimen/text_size_small</item>
        <item name="android:textColor">@color/gray2</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- 버튼 스타일 -->
    <style name="ButtonStyle">
        <item name="android:background">@drawable/button_background</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- 테두리 스타일 -->
    <style name="BorderStyle">
        <item name="android:background">@drawable/border_background</item>
    </style>

    <!-- 인풋 스타일 -->
    <style name="InputStyle">
        <item name="android:background">@drawable/border_background</item>
        <item name="android:padding">@dimen/spacing_input_field</item>
        <item name="android:textSize">@dimen/text_size_input</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

</resources>