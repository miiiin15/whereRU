<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="view"
            type="com.miiiin15.whereru.ui.home.HomeFragment" />

        <variable
            name="vm"
            type="com.miiiin15.whereru.presentation.viewmodel.HomeViewModel" />

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#ff0000"
        android:orientation="vertical"
        tools:context=".ui.home.HomeFragment">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/home_title_shimmer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/padding_horizontal"
            android:layout_marginTop="@dimen/margin_top_title"
            android:layout_marginBottom="@dimen/margin_title_to_content"
            app:shimmer_auto_start="true"
            app:shimmer_duration="2000">
            <TextView
                android:id="@+id/home_loading_text"
                style="@style/Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" 정보를 가져오는 중 "
                android:textColor="@color/gray1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </com.facebook.shimmer.ShimmerFrameLayout>

            <TextView
                android:visibility="gone"
                android:id="@+id/home_title_text"
                style="@style/Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/padding_horizontal"
                android:layout_marginTop="@dimen/margin_top_title"
                android:layout_marginBottom="@dimen/margin_title_to_content"
                android:text=""
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#dddddd"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/padding_horizontal"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/home_category_all_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:text="전체"
                android:textColor="@color/gray1"
                android:textSize="@dimen/text_size_large" />

            <TextView
                android:id="@+id/home_category_recent_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:text="최근"
                android:textColor="@color/gray1"
                android:textSize="@dimen/text_size_large" />

            <TextView
                android:id="@+id/home_category_favorite_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:text="즐겨찾기"
                android:textColor="@color/gray1"
                android:textSize="@dimen/text_size_large" />

        </LinearLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#00ff00"
            android:orientation="horizontal" />

        <Button
            android:id="@+id/home_navigate_location_button"
            style="@style/ButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/padding_horizontal"
            android:enabled="@{vm.fetched}"
            android:text="내 위치 공유하기" />

    </LinearLayout>

</layout>