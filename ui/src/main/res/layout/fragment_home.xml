<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="view"
            type="com.miiiin15.whereru.ui.home.HomeFragment" />

        <variable
            name="vm"
            type="com.miiiin15.whereru.presentation.viewmodel.HomeViewModel" />

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF0000"
        android:orientation="vertical"
        android:paddingBottom="@dimen/margin_bottom_button"
        tools:context=".ui.home.HomeFragment">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/padding_horizontal"
            android:layout_marginTop="@dimen/margin_top_title"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/home_title_text"
                style="@style/Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="홈" />

            <TextView
                android:id="@+id/home_setting_text"
                style="@style/Description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="설정" />
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/padding_horizontal"
            android:background="#0000FF"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/home_recent_text"
                style="@style/Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_title_to_content"
                android:text="최근"
                android:textColor="@color/gray1" />

            <TextView
                android:id="@+id/home_favorite_text"
                style="@style/Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="@dimen/margin_title_to_content"
                android:text="친구"
                android:textColor="@color/gray1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#00FF00"
            android:orientation="horizontal">

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none"
                tools:ignore="Suspicious0dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    tools:ignore="ScrollViewSize">

                    <!-- 첫 번째 RecyclerView 화면 -->
                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:padding="@dimen/padding_horizontal">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/home_recent_list"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#FFFF00"
                            android:clipToPadding="false"
                            android:padding="16dp" />
                    </FrameLayout>

                    <!-- 두 번째 RecyclerView 화면 -->
                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:padding="@dimen/padding_horizontal">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/home_favorite_list"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#00FFFF"
                            android:clipToPadding="false"
                            android:padding="16dp" />
                    </FrameLayout>

                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>


        <!-- 위치 요청 버튼 -->
        <Button
            android:id="@+id/home_navigate_location_button"
            style="@style/ButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/padding_horizontal"
            android:enabled="@{vm.fetched}"
            android:text="내 위치 공유하기" />


    </LinearLayout>

</layout>